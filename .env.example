# Copy to .env and fill in. Do not commit .env.

# Email (for comment monitoring inbox + outbound notifications)
COMMENT_INBOX_HOST=imap.gmail.com
COMMENT_INBOX_PORT=993
COMMENT_INBOX_USER=
COMMENT_INBOX_PASS=                    # Gmail app password, NOT account password

# SMTP for sending draft notifications to yourself
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=                             # where to send draft/reply notifications

# Storage
DB_PATH=./data/visibility.sqlite
IMAGES_DIR=./data/images

# Schedules (n8n cron expressions)
RSS_INGEST_CRON=0 6 * * *              # 6am daily
DRAFTING_CRON=0 9 */3 * *              # every 3 days at 9am
COMMENT_POLL_CRON=0 * * * *            # hourly
WEEKLY_METRICS_CRON=0 19 * * 0         # Sunday 7pm
WEEKLY_SUMMARY_CRON=0 21 * * 0         # Sunday 9pm

# Claude Code
CLAUDE_CMD=claude
CLAUDE_MODEL=sonnet                    # sonnet for routine work
CLAUDE_MAX_TURNS=4

# Image generation
AI_IMAGE_ENABLED=true                  # you opted in
POLLINATIONS_API_KEY=                  # pk_... from enter.pollinations.ai
POLLINATIONS_MODEL=flux

# Kill switch — set true to halt all scheduled jobs cleanly
SYSTEM_PAUSED=false
